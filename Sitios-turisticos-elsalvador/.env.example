# ==========================================
# Configuración de Supabase para Next.js
# ==========================================
# Reemplaza estos valores con las credenciales de tu proyecto Supabase:
# Panel de Supabase -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# (Opcional) Service Role Key para operaciones administrativas en el servidor
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui
